      "title": "Useful phrasal verbs with bring",
      "items": [
        {
          "en": "To bring about",
          "meanings": [
            "To make something happen."
          ]
        },
        {
          "en": "To bring along",
          "meanings": [
            "When you bring someone or something with you to a place."
          ]
        },
        {
          "en": "To bring around",
          "meanings": [
            "When you try to convince someone to change their mind."
          ]
        },
        {
          "en": "To bring back",
          "meanings": [
            "To remember.",
            "To return or reintroduce something."
          ]
        },
        {
          "en": "To bring down",
          "meanings": [
            "To lower something.",
            "To cause something to collapse."
          ]
        },
        {
          "en": "To bring forth",
          "meanings": [
            "To create or produce something"
          ]
        },
        {
          "en": "To bring forward",
          "meanings": [
            "To reschedule an event.",
            "To give an opinion to be taken into consideration."
          ]
        },
        {
          "en": "To bring in",
          "meanings": [
            "To introduce something.",
            "To generate revenue."
          ]
        },
        {
          "en": "To bring off",
          "meanings": [
            "To achieve something successfully."
          ]
        },
        {
          "en": "To bring on",
          "meanings": [
            "To trigger something."
          ]
        },
        {
          "en": "To bring out",
          "meanings": [
            "To publish something.",
            "To reveal something or to make something evident."
          ]
        },
        {
          "en": "To bring over",
          "meanings": [
            "To take something to another location."
          ]
        },
        {
          "en": "To bring up",
          "meanings": [
            "To mention a topic during a discussion.",
            "To raise a child until adulthood."
          ]
        }
      ]
    }
  ]
