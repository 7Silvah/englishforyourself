  "intro": "In this section you will learn useful phrasal verbs with be in English.",
  "groups": [
    {
      "title": "Useful phrasal verbs with be",
      "items": [
        {
          "en": "To be above",
          "meanings": [
            "To be socially superior."
          ]
        },
        {
          "en": "To be after",
          "meanings": [
            "To be searching or pursuing someone or something."
          ]
        },
        {
          "en": "To be against",
          "meanings": [
            "To have an opposing view with someone or something."
          ]
        },
        {
          "en": "To be around",
          "meanings": [
            "To be present."
          ]
        },
        {
          "en": "To be away",
          "meanings": [
            "When you are somewhere else."
          ]
        },
        {
          "en": "To be cut out for",
          "meanings": [
            "To be suited to do something."
          ]
        },
        {
          "en": "To be down",
          "meanings": [
            "When you are unhappy."
          ]
        },
        {
          "en": "To be down on",
          "meanings": [
            "When you dislike something or someone."
          ]
        },
        {
          "en": "To be down with",
          "meanings": [
            "To agree with an idea.",
            "To fall ill."
          ]
        },
        {
          "en": "To be in for",
          "meanings": [
            "To anticipate an event."
          ]
        },
        {
          "en": "To be in on",
          "meanings": [
            "To be part of something."
          ]
        },
        {
          "en": "To be into",
          "meanings": [
            "To be attracted by something."
          ]
        },
        {
          "en": "To be off",
          "meanings": [
            "To leave from somewhere.",
            "When food has gone bad."
          ]
        },
        {
          "en": "To be off something",
          "meanings": [
            "Stop using something."
          ]
        },
        {
          "en": "To be on about",
          "meanings": [
            "To talk about something continuously without knowing the meaning."
          ]
        },
        {
          "en": "To be on",
          "meanings": [
