      ],
      "explanationEs": "En la pasiva, to be toma el tiempo del verbo activo: speak → is spoken, built → was built, are painting → is being painted."
    },
    {
      "id": "2",
      "type": "categorize",
      "categories": [
        {
          "label": "Active",
          "labelEs": "el sujeto hace la acción",
          "items": [
            "She wrote a letter.",
            "They are building a school.",
            "We cleaned the kitchen."
          ]
        },
        {
          "label": "Passive",
          "labelEs": "el sujeto recibe la acción",
          "items": [
            "The letter was written.",
            "A school is being built.",
            "The kitchen was cleaned."
          ]
        }
      ],
      "explanationEs": "La pasiva lleva to be + participio; en la activa, el sujeto es quien hace la acción."
    },
