    {
      "id": "2",
      "type": "fill-blank",
      "text": "Ana ___ (to make) dinner now.",
      "blanks": [
        {
          "answers": [
            "is making"
          ]
        }
      ],
      "explanationEs": "Make termina en -e: se quita la e y se añade -ing. Making."
    },
    {
      "id": "3",
      "type": "fill-blank",
      "text": "I ___ (not / work) this week.",
      "blanks": [
        {
          "answers": [
            "am not working",
            "'m not working"
          ]
        }
      ],
      "explanationEs": "Negativa con I: am not + verbo-ing."
    },
    {
      "id": "4",
      "type": "transform",
      "source": "She is reading a book.",
      "to": "neg",
      "answers": [
        "She isn't reading a book.",
        "She's not reading a book."
      ],
      "explanationEs": "Negativa: is + not + reading."
    },
    {
      "id": "5",
      "type": "transform",
      "source": "They are playing football.",
      "to": "q",
      "answers": [
        "Are they playing football?"
      ],
      "explanationEs": "Pregunta: are va antes de they."
    },
    {
      "id": "6",
