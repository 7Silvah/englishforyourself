{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "ignorePatterns": ["dist/**", "src/routeTree.gen.ts"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      // shadcn exporta variantes (buttonVariants…) junto a los componentes, a propósito
      "files": ["src/components/ui/**"],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      // Cada ruta exporta "Route" y define su componente en el mismo archivo.
      // autoCodeSplitting del plugin del router separa el componente, así que el fast refresh funciona.
      "files": ["src/routes/**"],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
